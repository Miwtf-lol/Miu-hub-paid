local function getRarityColor(r)
    local colors = {
        Common = Color3.fromRGB(180, 180, 180),
        Rare = Color3.fromRGB(50, 150, 255),
        Epic = Color3.fromRGB(150, 50, 255),
        Legend = Color3.fromRGB(255, 150, 0),
        Legendary = Color3.fromRGB(255, 150, 0),
        Mythic = Color3.fromRGB(255, 50, 50),
        Godly = Color3.fromRGB(255, 215, 0),
        Secret = Color3.fromRGB(0, 255, 200),
        Divine = Color3.fromRGB(255, 100, 255),
        Hacked = Color3.fromRGB(0, 255, 0),
        OG = Color3.fromRGB(255, 0, 100),
        Celestial = Color3.fromRGB(100, 200, 255),
    }
    return colors[r] or Color3.fromRGB(255, 255, 255)
end

