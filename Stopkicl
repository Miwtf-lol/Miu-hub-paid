--// MIU HUB - REAL WAVE FREEZE
--// Strong Freeze Version

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local enabled = true

-- GUI
local gui = Instance.new("ScreenGui")
gui.Parent = player.PlayerGui
gui.ResetOnSpawn = false

local btn = Instance.new("TextButton")
btn.Parent = gui
btn.Size = UDim2.new(0,200,0,50)
btn.Position = UDim2.new(0.03,0,0.3,0)
btn.Text = "WAVE FREEZE : ON"
btn.BackgroundColor3 = Color3.fromRGB(255,105,180)
btn.TextColor3 = Color3.new(1,1,1)
btn.TextSize = 20
btn.Font = Enum.Font.GothamBold
btn.Active = true
btn.Draggable = true

Instance.new("UICorner", btn).CornerRadius = UDim.new(0,14)

btn.MouseButton1Click:Connect(function()

	enabled = not enabled

	if enabled then
		btn.Text = "WAVE FREEZE : ON"
		btn.BackgroundColor3 = Color3.fromRGB(255,105,180)
	else
		btn.Text = "WAVE FREEZE : OFF"
		btn.BackgroundColor3 = Color3.fromRGB(80,80,80)
	end
end)

-- FORCE FREEZE LOOP
RunService.RenderStepped:Connect(function()

	if not enabled then
		return
	end

	for _,v in pairs(Workspace:GetDescendants()) do

		if v:IsA("BasePart") then

			local n = v.Name:lower()

			if string.find(n,"wave")
			or string.find(n,"water")
			or string.find(n,"tsunami")
			or string.find(n,"ocean")
			or string.find(n,"sea") then

				-- HARD FREEZE
				v.Anchored = true
				v.CanCollide = false

				v.AssemblyLinearVelocity = Vector3.zero
				v.AssemblyAngularVelocity = Vector3.zero

				v.Velocity = Vector3.zero
				v.RotVelocity = Vector3.zero

				-- chống tween
				v.CFrame = v.CFrame
			end
		end

		-- Disable wave scripts
		if v:IsA("Script") or v:IsA("LocalScript") then

			local n = v.Name:lower()

			if string.find(n,"wave")
			or string.find(n,"water")
			or string.find(n,"tsunami") then

				v.Disabled = true
			end
		end
	end
end)

print("MIU HUB Real Freeze Loaded")
