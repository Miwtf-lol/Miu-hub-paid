-- Phát hiện và lưu wave objects
local function findWaveObjects()
    waveObjects = {}
    for _, obj in pairs(Workspace:GetChildren()) do
        local nameLower = obj.Name:lower()
        -- Adjust detection dựa trên game (thêm/remove patterns nếu cần)
        if nameLower:find("wave") or nameLower:find("tsunami") or nameLower:find("tidal") or nameLower:find("water") then
            if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Model") then
                table.insert(waveObjects, obj)
            end
        end
        -- Cũng kiểm tra children của Workspace thường chứa các part lớn
        if obj:IsA("BasePart") and obj.Size.X > 30 and obj.Size.Z > 30 then
            table.insert(waveObjects, obj)
        end
    end
    return #waveObjects > 0
end

-- Freeze wave: ẩn hết wave objects
local function freezeWave()
    if waveFrozen then return end
    
    findWaveObjects()
    if #waveObjects == 0 then
        -- Nếu ko detect được, thử ẩn theo pattern
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj:IsA("BasePart") then
                obj.Transparency = 1
                obj.CanCollide = false
                obj.Anchored = true
                table.insert(waveObjects, obj)
            end
        end
    end
    
    for _, obj in pairs(waveObjects) do
        if obj and obj.Parent then
            obj.Transparency = 1
            obj.CanCollide = false
            obj.Anchored = true
            if obj:IsA("Model") then
                for _, part in pairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 1
                        part.CanCollide = false
                        part.Anchored = true
                    end
                end
            end
        end
    end
    
    waveFrozen = true
    humanoid.WalkSpeed = normalSpeed
    statusLabel.Text = "❄️ Wave: FROZEN"
    statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    toggleBtn.Text = "▶️ RESUME WAVE"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 120)
    print("[Wave] Freezed " .. #waveObjects .. " wave objects")
end

-- Resume wave: hiện lại wave objects
local function resumeWave()
    if not waveFrozen then return end
    
    for _, obj in pairs(waveObjects) do
        if obj and obj.Parent then
            obj.Transparency = 0
            obj.CanCollide = true
            obj.Anchored = false
            if obj:IsA("Model") then
                for _, part in pairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0
                        part.CanCollide = true
                        part.Anchored = false
                    end
                end
            end
        end
    end
    
    waveObjects = {}
    waveFrozen = false
    humanoid.WalkSpeed = godSpeed
    statusLabel.Text = "🌊 Wave: RUNNING"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    toggleBtn.Text = "⏸ FREEZE WAVE"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    print("[Wave] Resumed - wave is active again")
end

-- Toggle chính
local function toggleWave()
    if waveFrozen then
        resumeWave()
    else
        freezeWave()
    end
end

-- Nút bấm
toggleBtn.MouseButton1Click:Connect(toggleWave)

-- Hotkey: Press "F" để toggle
