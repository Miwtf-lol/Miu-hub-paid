--// MIU HUB - WAVE FREEZE BY RARITY

local Players = game:GetService("Players")
local player = Players.LocalPlayer

------------------------------------------------
-- GUI
------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "MIU_WAVE"
gui.ResetOnSpawn = false

pcall(function()
	gui.Parent = game.CoreGui
end)

if not gui.Parent then
	gui.Parent = player:WaitForChild("PlayerGui")
end

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0,260,0,320)
frame.Position = UDim2.new(0.03,0,0.3,0)
frame.BackgroundColor3 = Color3.fromRGB(20,20,30)
frame.Active = true
frame.Draggable = true

Instance.new("UICorner",frame).CornerRadius = UDim.new(0,12)

------------------------------------------------
-- TITLE
------------------------------------------------

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1,0,0,35)
title.BackgroundTransparency = 1
title.Text = "🌊 MIU WAVE FREEZE"
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.TextColor3 = Color3.new(1,1,1)

------------------------------------------------
-- STATUS
------------------------------------------------

local status = Instance.new("TextLabel")
status.Parent = frame
status.Size = UDim2.new(1,-20,0,25)
status.Position = UDim2.new(0,10,0,40)
status.BackgroundTransparency = 1
status.Text = "STATUS : OFF"
status.Font = Enum.Font.Gotham
status.TextSize = 14
status.TextColor3 = Color3.fromRGB(255,100,100)
status.TextXAlignment = Enum.TextXAlignment.Left

------------------------------------------------
-- CURRENT RARITY
------------------------------------------------

local rarityLabel = Instance.new("TextLabel")
rarityLabel.Parent = frame
rarityLabel.Size = UDim2.new(1,-20,0,25)
rarityLabel.Position = UDim2.new(0,10,0,65)
rarityLabel.BackgroundTransparency = 1
rarityLabel.Text = "RARITY : Rare"
rarityLabel.Font = Enum.Font.Gotham
rarityLabel.TextSize = 14
rarityLabel.TextColor3 = Color3.fromRGB(255,200,100)
rarityLabel.TextXAlignment = Enum.TextXAlignment.Left

------------------------------------------------
-- RARITY LIST
------------------------------------------------

local rarityList = {
	"Common",
	"Rare",
	"Epic",
	"Legend",
	"Mythic",
	"Godly",
	"Secret",
	"Divine",
	"Hacked",
	"OG",
	"Celestial"
}

local currentSelection = 2

local function getRarityColor(r)
	local colors = {
		Common = Color3.fromRGB(180,180,180),
		Rare = Color3.fromRGB(50,150,255),
		Epic = Color3.fromRGB(180,50,255),
		Legend = Color3.fromRGB(255,170,0),
		Mythic = Color3.fromRGB(255,60,60),
		Godly = Color3.fromRGB(255,220,0),
		Secret = Color3.fromRGB(0,255,200),
		Divine = Color3.fromRGB(255,100,255),
		Hacked = Color3.fromRGB(0,255,0),
		OG = Color3.fromRGB(255,0,100),
		Celestial = Color3.fromRGB(120,220,255)
	}

	return colors[r] or Color3.new(1,1,1)
end

------------------------------------------------
-- DROPDOWN BUTTON
------------------------------------------------

local picker = Instance.new("TextButton")
picker.Parent = frame
picker.Size = UDim2.new(1,-20,0,35)
picker.Position = UDim2.new(0,10,0,100)
picker.BackgroundColor3 = Color3.fromRGB(40,40,60)
picker.Text = "SELECT : "..rarityList[currentSelection]
picker.TextColor3 = getRarityColor(rarityList[currentSelection])
picker.Font = Enum.Font.GothamBold
picker.TextSize = 15

Instance.new("UICorner",picker).CornerRadius = UDim.new(0,8)

------------------------------------------------
-- DROPDOWN
------------------------------------------------

local dropdown = Instance.new("Frame")
dropdown.Parent = frame
dropdown.Size = UDim2.new(1,-20,0,160)
dropdown.Position = UDim2.new(0,10,0,145)
dropdown.BackgroundColor3 = Color3.fromRGB(30,30,40)
dropdown.Visible = false

Instance.new("UICorner",dropdown).CornerRadius = UDim.new(0,8)

------------------------------------------------
-- CREATE ITEMS
------------------------------------------------

for i,v in ipairs(rarityList) do
	local btn = Instance.new("TextButton")
	btn.Parent = dropdown
	btn.Size = UDim2.new(1,-10,0,22)
	btn.Position = UDim2.new(0,5,0,(i-1)*23)
	btn.BackgroundColor3 = Color3.fromRGB(45,45,60)
	btn.Text = v
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.TextColor3 = getRarityColor(v)

	Instance.new("UICorner",btn).CornerRadius = UDim.new(0,6)

	btn.MouseButton1Click:Connect(function()
		currentSelection = i

		picker.Text = "SELECT : "..v
		picker.TextColor3 = getRarityColor(v)

		rarityLabel.Text = "RARITY : "..v

		dropdown.Visible = false
	end)
end

------------------------------------------------
-- OPEN / CLOSE
------------------------------------------------

picker.MouseButton1Click:Connect(function()
	dropdown.Visible = not dropdown.Visible
end)

------------------------------------------------
-- TOGGLE BUTTON
------------------------------------------------

local enabled = false

local toggle = Instance.new("TextButton")
toggle.Parent = frame
toggle.Size = UDim2.new(1,-20,0,40)
toggle.Position = UDim2.new(0,10,1,-50)
toggle.BackgroundColor3 = Color3.fromRGB(255,100,140)
toggle.Text = "FREEZE : OFF"
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 18
toggle.TextColor3 = Color3.new(1,1,1)

Instance.new("UICorner",toggle).CornerRadius = UDim.new(0,10)

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		toggle.Text = "FREEZE : ON"
		status.Text = "STATUS : ACTIVE"
		status.TextColor3 = Color3.fromRGB(0,255,120)
	else
		toggle.Text = "FREEZE : OFF"
		status.Text = "STATUS : OFF"
		status.TextColor3 = Color3.fromRGB(255,100,100)
	end
end)

print("MIU WAVE GUI LOADED")
