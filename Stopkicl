-- =========================
-- FREEZE SYSTEM
-- =========================

local function FreezeWave()

	waveFrozen = true

	Status.Text = "Wave Status : FROZEN"
	Status.TextColor3 = Color3.fromRGB(0,255,255)

	Toggle.Text = "FREEZE : ON"
	Toggle.BackgroundColor3 = Color3.fromRGB(255,80,170)

	frozenParts = {}

	for _, obj in pairs(Workspace:GetDescendants()) do

		if obj:IsA("BasePart") then

			local n = obj.Name:lower()

			if string.find(n,"wave")
			or string.find(n,"tsunami")
			or string.find(n,"water")
			or string.find(n,"ocean")
			or string.find(n,"sea") then

				frozenParts[obj] = {
					Anchored = obj.Anchored,
					Velocity = obj.AssemblyLinearVelocity,
					RotVelocity = obj.AssemblyAngularVelocity
				}

				obj.Anchored = true
				obj.AssemblyLinearVelocity = Vector3.zero
				obj.AssemblyAngularVelocity = Vector3.zero
			end
		end

		-- Disable scripts tạo sóng
		if obj:IsA("Script") or obj:IsA("LocalScript") then

			local n = obj.Name:lower()

			if string.find(n,"wave")
			or string.find(n,"tsunami")
			or string.find(n,"water") then

				obj.Disabled = true
			end
		end
	end
end

local function UnfreezeWave()

	waveFrozen = false

	Status.Text = "Wave Status : NORMAL"
	Status.TextColor3 = Color3.fromRGB(0,255,100)

	Toggle.Text = "FREEZE : OFF"
	Toggle.BackgroundColor3 = Color3.fromRGB(255,130,200)

	for obj, data in pairs(frozenParts) do

		if obj and obj.Parent then

			obj.Anchored = data.Anchored
			obj.AssemblyLinearVelocity = data.Velocity
			obj.AssemblyAngularVelocity = data.RotVelocity
		end
	end

	frozenParts = {}

	-- Enable scripts lại
	for _, obj in pairs(Workspace:GetDescendants()) do

		if obj:IsA("Script") or obj:IsA("LocalScript") then

			local n = obj.Name:lower()

			if string.find(n,"wave")
			or string.find(n,"tsunami")
			or string.find(n,"water") then

				obj.Disabled = false
			end
		end
	end
end

-- =========================
-- BUTTON EVENTS
-- =========================

Toggle.MouseButton1Click:Connect(function()

	if waveFrozen then
		UnfreezeWave()
	else
		FreezeWave()
	end
end)

-- KEYBOARD TOGGLE

UserInputService.InputBegan:Connect(function(input,gp)

	if gp then return end

	if input.KeyCode == Enum.KeyCode.F then

		if waveFrozen then
			UnfreezeWave()
		else
			FreezeWave()
		end
	end
end)

