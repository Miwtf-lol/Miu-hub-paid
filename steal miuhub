-- Hàm cập nhật UI
local function updateUI(data)
    if data then
        targetLabel.Text = "Target Base: " .. data.Player.Name .. "'s Base"
        countLabel.Text = "Brainrots: " .. data.Count .. " detected"
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and data.Base then
            local myPos = LocalPlayer.Character.HumanoidRootPart.Position
            local basePos = nil
            
            if data.Base:IsA("BasePart") then
                basePos = data.Base.Position
            elseif data.Base:IsA("Model") and data.Base.PrimaryPart then
                basePos = data.Base.PrimaryPart.Position
            end
            
            if basePos then
                local dist = (myPos - basePos).Magnitude
                distLabel.Text = "Distance: " .. math.floor(dist) .. "m"
            end
        end
        
        stealBtn.Text = "🏠 STEAL " .. data.Count .. " BRAINROTS FROM " .. data.Player.Name
    else
        targetLabel.Text = "Target Base: None"
        countLabel.Text = "Brainrots: 0 detected"
        distLabel.Text = "Distance: --"
        stealBtn.Text = "🏠 STEAL ALL BRAINROTS FROM NEAREST BASE"
    end
end

