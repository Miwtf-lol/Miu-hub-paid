if not hookSuccess then
    addStatus("⚠️ RemoteSpy: hookfunction não suportado. Usando scan manual.", Color3.fromRGB(255, 150, 50))
    
    -- Método 3: substituir FireServer em cada RemoteEvent manualmente
    task.spawn(function()
        local allRemotes = scanRemotes()
        for _, remote in ipairs(allRemotes) do
            local originalFire = remote.FireServer
            local remotePath = remote:GetFullName()
            
            if not fireServerHooks[remotePath] then
                local success = pcall(function()
                    remote.FireServer = function(self, ...)
                        local args = {...}
