-- Função para tentar todas as combinações de argumentos
local function tryAllFormats(brainrotName, playerName)
    local plr = playerName ~= "" and Players:FindFirstChild(playerName) or nil
    local targetPlayerId = plr and plr.UserId or 0
    local targetPlayerObj = plr
    
    if not rev_S_Steal then
        addStatus("❌ rev_S_Steal não encontrado! Não é possível continuar.", Color3.fromRGB(255, 100, 100))
        return false
    end
    
    addStatus("🚀 Tentando roubar: " .. brainrotName .. " de " .. playerName, Color3.fromRGB(100, 255, 200))
    
    -- Lista de formatos de argumentos para tentar
    local attempts = {}
    
    -- Formato 1: Apenas string (nome do brainrot)
    table.insert(attempts, {brainrotName})
    
    -- Formato 2: Nome do brainrot + nome do jogador
    if playerName ~= "" then
        table.insert(attempts, {brainrotName, playerName})
        table.insert(attempts, {playerName, brainrotName})
    end
    
    -- Formato 3: Nome do brainrot + objeto do jogador
    if targetPlayerObj then
        table.insert(attempts, {brainrotName, targetPlayerObj})
        table.insert(attempts, {targetPlayerObj, brainrotName})
    end
    
    -- Formato 4: UserId
    if targetPlayerId > 0 then
        table.insert(attempts, {brainrotName, targetPlayerId})
        table.insert(attempts, {targetPlayerId, brainrotName})
        table.insert(attempts, {tostring(targetPlayerId), brainrotName})
    end
    
    -- Formato 5: Tabela com nome do brainrot
    table.insert(attempts, {{Name = brainrotName}})
    table.insert(attempts, {{Target = brainrotName}})
    table.insert(attempts, {{brainrot = brainrotName}})
    
    -- Formato 6: string, string (nome, id do jogador)
    if targetPlayerObj then
        table.insert(attempts, {brainrotName, tostring(targetPlayerObj.UserId)})
    end
    
    -- Formato 7: Apenas o nome do brainrot em minúsculo
    table.insert(attempts, {brainrotName:lower()})
    
    -- Formato 8: Tabela com nome e jogador
    if targetPlayerObj then
        table.insert(attempts, {{Brainrot = brainrotName, Player = targetPlayerObj}})
        table.insert(attempts, {{brainrotName, targetPlayerObj}})
    end
    
    -- Formato 9: Número (ID do brainrot)
    table.insert(attempts, {tostring(brainrotName)})
    
    -- Tentar cada formato
    for i, args in ipairs(attempts) do
        local success, result = pcall(function()
            rev_S_Steal:FireServer(unpack(args))
        end)
        
        local argsStr = ""
        for _, v in ipairs(args) do
            argsStr = argsStr .. ", " .. tostring(v)
        end
        argsStr = argsStr:sub(3)
        
        if success then
            addStatus(string.format("✅ [%d/%d] rev_S_Steal:FireServer(%s) -> SUCESSO!", i, #attempts, argsStr), Color3.fromRGB(100, 255, 100))
            return true
        else
            addStatus(string.format("❌ [%d/%d] rev_S_Steal:FireServer(%s) -> Falhou", i, #attempts, argsStr), Color3.fromRGB(150, 100, 100))
        end
        
        task.wait(0.3)
    end
    
    return false
end

-- Função para tentar DeliverySteal (quando o brainrot está weldado no personagem)
local function tryDeliverySteal()
    if not DeliverySteal then
        addStatus("❌ DeliverySteal não encontrado!", Color3.fromRGB(255, 100, 100))
        return false
    end
    
    addStatus("🚀 Tentando DeliverySteal (verificando WeldConstraint)...", Color3.fromRGB(100, 200, 255))
    
    -- Procurar por brainrots weldados no personagem
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local root = char.HumanoidRootPart
        
        -- Verificar se há WeldConstraint no HumanoidRootPart conectado a um brainrot
        for _, constraint in pairs(root:GetChildren()) do
            if constraint:IsA("WeldConstraint") and constraint.Part1 then
                local attachedPart = constraint.Part1
                addStatus(string.format("🔗 WeldConstraint encontrado: Part1 = %s", attachedPart.Name), Color3.fromRGB(100, 200, 255))
                
                -- Tenta DeliverySteal
                local success, result = pcall(function()
                    DeliverySteal:FireServer()
                end)
                
                if success then
                    addStatus("✅ DeliverySteal:FireServer() -> SUCESSO!", Color3.fromRGB(100, 255, 100))
                    return true
                else
                    addStatus("❌ DeliverySteal:FireServer() -> Falhou", Color3.fromRGB(150, 100, 100))
                end
                
                -- Tenta com argumentos
                local argsVariants = {
                    {attachedPart},
                    {attachedPart.Name},
                    {attachedPart, root},
                    {{Object = attachedPart, Target = root}},
                }
                
                for i, args in ipairs(argsVariants) do
                    local s, r = pcall(function()
                        DeliverySteal:FireServer(unpack(args))
                    end)
                    if s then
                        addStatus(string.format("✅ DeliverySteal com args -> SUCESSO!"), Color3.fromRGB(100, 255, 100))
                        return true
                    end
                    task.wait(0.2)
                end
            end
        end
        
        -- Verificar todo o workspace por brainrots weldados no personagem
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("WeldConstraint") and obj.Part1 and (obj.Part0 == root or obj.Part1 == root) then
                local otherPart = (obj.Part0 == root) and obj.Part1 or obj.Part0
                if otherPart then
                    addStatus(string.format("🔗 WeldConstraint no workspace: %s conectado a %s", otherPart.Name, root.Name), Color3.fromRGB(100, 200, 255))
                    
                    local s, r = pcall(function()
                        DeliverySteal:FireServer()
                    end)
                    if s then
                        addStatus("✅ DeliverySteal:FireServer() via workspace -> SUCESSO!", Color3.fromRGB(100, 255, 100))
                        return true
                    end
                end
            end
        end
    end
    
    -- Se não encontrar WeldConstraint, tenta mesmo assim
    addStatus("⚠️ Nenhum WeldConstraint encontrado. Tentando DeliverySteal mesmo assim...", Color3.fromRGB(255, 200, 100))
    local s, r = pcall(function()
        DeliverySteal:FireServer()
    end)
    if s then
        addStatus("✅ DeliverySteal:FireServer() -> SUCESSO!", Color3.fromRGB(100, 255, 100))
        return true
    end
    
    addStatus("❌ DeliverySteal falhou. Tente ficar mais perto do brainrot.", Color3.fromRGB(255, 100, 100))
    return false
end

