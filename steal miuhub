-- Função para escanear RemoteEvents
local function scanRemotes()
    local remotes = {}
    local function scan(instance)
        if instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction") then
            table.insert(remotes, instance)
        end
        for _, child in pairs(instance:GetChildren()) do
            scan(child)
        end
    end
    scan(ReplicatedStorage)
    scan(workspace)
    return remotes
end

-- Hook FireServer usando hookfunction (para executors que suportam)
local hookSuccess = false
local oldFireServer = nil

-- Tenta método 1: hookfunction no FireServer
pcall(function()
    local RemoteEventClass = Instance.new("RemoteEvent")
    oldFireServer = RemoteEventClass.FireServer
    
    local hooked = hookfunction(RemoteEventClass.FireServer, function(self, ...)
        local args = {...}
        local argsStr = ""
        for i, v in ipairs(args) do
            if i > 1 then
                argsStr = argsStr .. ", "
            end
            argsStr = argsStr .. tostring(v) .. " (" .. typeof(v) .. ")"
        end
        
        local logText = string.format("📡 %s:FireServer(%s)", self:GetFullName(), argsStr)
        addStatus(logText, Color3.fromRGB(255, 200, 100))
        
        -- Salva no log
        table.insert(remoteLog, {
            remote = self,
            path = self:GetFullName(),
            args = args,
            time = tick()
        })
        
        -- Limitar log
        if #remoteLog > 50 then
            table.remove(remoteLog, 1)
        end
        
        return oldFireServer(self, ...)
    end)
    
    hookSuccess = true
    addStatus("✅ RemoteSpy ativado! (hookfunction)", Color3.fromRGB(100, 255, 100))
end)

