-- Função para log
local function log(msg, color)
    color = color or Color3.fromRGB(255,255,255)
    warn("[STEAL] " .. msg)
    if game:GetService("CoreGui"):FindFirstChild("HackerAISteal") then
        local frame = game:GetService("CoreGui").HackerAISteal
        if frame and frame.Status then
            frame.Status.Text = msg
            frame.Status.TextColor3 = color
        end
    end
end

-- Função para tentar FireServer com múltiplos formatos de argumento
local function fireStealRemote(targetName, targetPlayer)
    -- Caminhos possíveis para o RemoteEvent
    local remotePaths = {
        ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Packages") and ReplicatedStorage.Shared.Packages:FindFirstChild("Network") and ReplicatedStorage.Shared.Packages.Network:FindFirstChild("rev_S_Steal"),
        ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Net") and ReplicatedStorage.Packages.Net:FindFirstChild("rev_S_Steal"),
        ReplicatedStorage:FindFirstChild("rev_S_Steal"),
        ReplicatedStorage:FindFirstChild("Network") and ReplicatedStorage.Network:FindFirstChild("rev_S_Steal"),
    }
    
    local remote = nil
    for _, r in ipairs(remotePaths) do
        if r and r:IsA("RemoteEvent") then
            remote = r
            break
        end
    end
    
    if not remote then
        -- Busca exaustiva
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") and (obj.Name == "rev_S_Steal" or obj.Name:match("rev_S_Steal")) then
                remote = obj
                break
            end
        end
    end
    
    if not remote then
        log("❌ RemoteEvent rev_S_Steal não encontrado!", Color3.fromRGB(255,0,0))
        return false
    end
    
    log("🔍 RemoteEvent encontrado: " .. remote:GetFullName())
    
    -- TENTATIVAS DE ARGUMENTOS
    local attemptFormats = {
        -- Formato 1: Apenas nome do brainrot (string)
        function() remote:FireServer(targetName) end,
        -- Formato 2: Nome e player alvo
        function() remote:FireServer(targetName, targetPlayer) end,
        -- Formato 3: Player alvo, nome
        function() remote:FireServer(targetPlayer, targetName) end,
        -- Formato 4: Tabela com nome
        function() remote:FireServer({name = targetName}) end,
        -- Formato 5: Índice 1 = nome
        function() remote:FireServer({[1] = targetName}) end,
        -- Formato 6: Nome + quantidade 1
        function() remote:FireServer(targetName, 1) end,
        -- Formato 7: ID do brainrot (hash do nome)
        function() remote:FireServer(targetName:lower():gsub("%s+", "")) end,
        -- Formato 8: Apenas FireServer vazio (steal aleatório)
        function() remote:FireServer() end,
        -- Formato 9: Nome do brainrot + nome do jogador alvo
        function() remote:FireServer(targetName, targetPlayer and targetPlayer.Name or "") end,
        -- Formato 10: Tabela completa
        function() remote:FireServer({Name = targetName, Player = targetPlayer}) end,
        -- Formato 11: String vazia + nome
        function() remote:FireServer("", targetName) end,
        -- Formato 12: Nome + true
        function() remote:FireServer(targetName, true) end,
        -- Formato 13: Player + nome + bool
        function() remote:FireServer(targetPlayer, targetName, true) end,
        -- Formato 14: Apenas "steal" + nome
        function() remote:FireServer("steal", targetName) end,
        -- Formato 15: Nome do brainrot + CFrame
        function() remote:FireServer(targetName, CFrame.new(0,0,0)) end,
    }
    
    for i, attempt in ipairs(attemptFormats) do
        local success, err = pcall(attempt)
        if success then
            log("✅ Tentativa " .. i .. " bem-sucedida! Argumento: " .. targetName, Color3.fromRGB(0,255,0))
            return true
        else
            log("⚠️ Tentativa " .. i .. " falhou: " .. tostring(err))
        end
    end
    
    log("❌ Todas as tentativas falharam para: " .. targetName, Color3.fromRGB(255,0,0))
    return false
end

-- Tenta também DeliverySteal
local function tryDeliverySteal()
    local deliveryPaths = {
        ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Net") and ReplicatedStorage.Packages.Net:FindFirstChild("RE/StealService/DeliverySteal"),
        ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Packages") and ReplicatedStorage.Shared.Packages:FindFirstChild("Network") and ReplicatedStorage.Shared.Packages.Network:FindFirstChild("RE/StealService/DeliverySteal"),
    }
    
    local deliveryRemote = nil
    for _, r in ipairs(deliveryPaths) do
        if r then
            deliveryRemote = r
            break
        end
    end
    
    if not deliveryRemote then
        -- Busca exaustiva
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") and (obj.Name == "DeliverySteal" or obj.Name:match("DeliverySteal")) then
                deliveryRemote = obj
                break
            end
        end
    end
    
    if deliveryRemote then
        log("✅ DeliverySteal encontrado: " .. deliveryRemote:GetFullName())
        local success, err = pcall(function()
            deliveryRemote:FireServer()
        end)
        if success then
            log("✅ DeliverySteal executado com sucesso!", Color3.fromRGB(0,255,0))
        else
            log("❌ DeliverySteal falhou: " .. tostring(err))
        end
    end
end

-- Função para encontrar brainrots pelo nome em Workspace
local function findBrainrotInWorkspace(name)
    local results = {}
    name = name:lower():gsub("%s+", "")
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local objName = (obj.Name or ""):lower():gsub("%s+", "")
        if objName:find(name) or name:find(objName) then
            table.insert(results, obj)
        end
        -- Verifica também o DisplayName se existir
        if obj:IsA("Model") then
            for _, child in ipairs(obj:GetDescendants()) do
                local childName = (child.Name or ""):lower():gsub("%s+", "")
                if childName:find(name) or name:find(childName) then
                    table.insert(results, child)
                end
            end
        end
    end
    
    return results
end

-- Função para encontrar bases de outros jogadores
local function findBases()
    local bases = {}
    -- Procura por estruturas de base no Workspace
    local baseKeywords = {"base", "plot", "tycoon", "claim", "terrain"}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local objName = (obj.Name or ""):lower()
        for _, kw in ipairs(baseKeywords) do
            if objName:find(kw) then
                table.insert(bases, obj)
                break
            end
        end
    end
    
    -- Procura por partes com tags de jogador
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Model") then
            -- Verifica se tem atributo de dono
            local ownerAttr = part:GetAttribute("Owner") or part:GetAttribute("owner")
            if ownerAttr and ownerAttr ~= LocalPlayer.Name then
                table.insert(bases, part)
            end
        end
    end
    
    return bases
end

-- Função para teleportar para uma base
local function teleportToBase(base)
    if not base then return end
    local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local targetPos
    if base:IsA("Model") and base:FindFirstChild("PrimaryPart") then
        targetPos = base.PrimaryPart.Position
    elseif base:IsA("BasePart") then
        targetPos = base.Position
    elseif base:IsA("Model") then
        local parts = base:GetDescendants()
        for _, part in ipairs(parts) do
            if part:IsA("BasePart") then
                targetPos = part.Position
                break
            end
        end
    end
    
    if targetPos then
        rootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        log("✅ Teleportado para base: " .. base:GetFullName(), Color3.fromRGB(0,255,0))
        wait(0.5)
    end
end

