-- Tìm RemoteEvent rev_S_Steal (và các remote liên quan)
local RemoteEvent = nil
local RemoteEventAlt = nil

local function findAllRelevantRemotes()
    local results = {}
    
    local function deepSearch(instance, depth)
        if depth > 6 then return end
        for _, child in ipairs(instance:GetChildren()) do
            if (child:IsA("RemoteEvent") or child:IsA("RemoteFunction")) then
                local name = child.Name:lower()
                if name:find("steal") or name:find("brainrot") or name:find("lucky") or name:find("rev") then
                    table.insert(results, child)
                end
            end
            deepSearch(child, depth + 1)
        end
    end
    
    deepSearch(ReplicatedStorage, 0)
    return results
end

-- Tìm theo path chính xác trước
local function findExactPath()
    local path = { "Shared", "Packages", "Network", "rev_S_Steal" }
    local obj = ReplicatedStorage
    for _, name in ipairs(path) do
        obj = obj:FindFirstChild(name)
        if not obj then return nil end
    end
    return obj
end

RemoteEvent = findExactPath()

if not RemoteEvent then
    -- Tìm tất cả remote liên quan
    local allRemotes = findAllRelevantRemotes()
    
    if #allRemotes > 0 then
        RemoteEvent = allRemotes[1]
        print("[*] Found remote:", RemoteEvent:GetFullName())
    else
        warn("[!] rev_S_Steal not found! Liệt kê tất cả RemoteEvent:")
        local count = 0
        local function listAll(inst, depth)
            if depth > 4 then return end
            for _, c in ipairs(inst:GetChildren()) do
                if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                    count = count + 1
                    warn("  [" .. count .. "] " .. c:GetFullName())
                end
                listAll(c, depth + 1)
            end
        end
        listAll(ReplicatedStorage, 0)
        warn("[!] Không tìm thấy remote steal nào!")
        return
    end
end

-- Lấy tất cả thông tin về brainrot hiện tại trong game
local Brainrots = {}
local function scanBrainrots()
    Brainrots = {}
    
    -- Quét workspace tìm các vật phẩm brainrot
    local workspace = game:GetService("Workspace")
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("brainrot") or name:find("lucky.block") or obj:IsA("Model") and obj.PrimaryPart then
            -- Kiểm tra xem brainrot này có đang được carry bởi người chơi nào không
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    -- Kiểm tra khoảng cách
                    if player.Character:FindFirstChild("HumanoidRootPart") and obj:IsA("BasePart") then
                        local dist = (player.Character.HumanoidRootPart.Position - obj.Position).Magnitude
                        if dist < 10 then
                            table.insert(Brainrots, {
                                Object = obj,
                                Carrier = player,
                                Distance = dist
                            })
                        end
                    end
                end
            end
        end
    end
    
    return #Brainrots
end

-- === HÀM STEAL CHÍNH - GỬI TRỰC TIẾP ===
local function forceStealBrainrot(targetPlayer)
    if not targetPlayer then return false, "No target" end
    if not RemoteEvent then return false, "No remote event" end
    
    -- Các format args có thể có, thử lần lượt
    local argFormats = {
        -- Format 1: Object player
        function() return { targetPlayer } end,
        -- Format 2: UserId
        function() return { targetPlayer.UserId } end,
        -- Format 3: Tên
        function() return { targetPlayer.Name } end,
        -- Format 4: Tên + UserId
        function() return { targetPlayer.Name, targetPlayer.UserId } end,
        -- Format 5: Character + UserId
        function() 
            if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                return { targetPlayer.Character, targetPlayer.UserId }
            end
            return nil
        end,
        -- Format 6: Vị trí brainrot (nếu có object)
        function()
            if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                return { targetPlayer.Character.HumanoidRootPart.Position, targetPlayer.UserId }
            end
            return nil
        end,
        -- Format 7: UserId + "Brainrot"
        function() return { targetPlayer.UserId, "Brainrot" } end,
        -- Format 8: Object player + true (force)
        function() return { targetPlayer, true } end,
        -- Format 9: Object player + "Steal"
        function() return { targetPlayer, "Steal" } end,
        -- Format 10: targetPlayer.Character
        function()
            if targetPlayer.Character then return { targetPlayer.Character } end
            return nil
        end,
    }
    
    for i, formatFunc in ipairs(argFormats) do
        local args = formatFunc()
        if args then
            local success, err = pcall(function()
                RemoteEvent:FireServer(unpack(args))
            end)
            if success then
                -- Gửi nhiều lần để đảm bảo server nhận
                for _ = 1, 3 do
                    pcall(function()
                        RemoteEvent:FireServer(unpack(args))
                    end)
                    wait(0.05)
                end
                return true, "Format " .. i
            end
        end
    end
    
    return false, "All formats failed"
end

-- Tìm người chơi gần nhất (đang carry brainrot hoặc bất kỳ)
local function findNearestTarget()
    local nearest = nil
    local minDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = player
            end
        end
    end
    
    return nearest
end

-- Lấy brainrot object từ click chuột
local function getBrainrotFromClick(target)
    if not target then return nil end
    
    -- Kiểm tra nếu click vào brainrot (object trên workspace)
    local obj = target
    local carrier = nil
    
    -- Tìm player đang ở gần object này
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if obj:IsA("BasePart") then
                local dist = (player.Character.HumanoidRootPart.Position - obj.Position).Magnitude
                if dist < 15 then
                    carrier = player
                    break
                end
            end
        end
    end
    
    -- Nếu click trực tiếp vào người chơi
    if not carrier then
        if target.Parent then
            local model = target
            if model:IsA("Model") and model:FindFirstChild("Humanoid") then
                carrier = Players:GetPlayerFromCharacter(model)
            elseif target.Parent:IsA("Model") and target.Parent:FindFirstChild("Humanoid") then
                carrier = Players:GetPlayerFromCharacter(target.Parent)
            elseif target.Parent.Parent and target.Parent.Parent:IsA("Model") and target.Parent.Parent:FindFirstChild("Humanoid") then
                carrier = Players:GetPlayerFromCharacter(target.Parent.Parent)
            end
        end
    end
    
    return obj, carrier
end

