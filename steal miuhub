-- === ENCONTRAR BASE DOS JOGADORES ===
local function findPlayerBase(player)
    -- Nomes comuns de base no jogo
    local patterns = {
        player.Name .. "'s Base",
        player.Name .. "sBase",
        player.Name .. "_Base",
        player.Name .. "Base",
        "Base_" .. player.Name,
        player.Name .. "'s_Tycoon",
        player.Name .. "Tycoon",
        player.Name,
        tostring(player.UserId),
        "Plot_" .. tostring(player.UserId),
    }
    
    for _, name in ipairs(patterns) do
        local obj = Workspace:FindFirstChild(name)
        if obj then return obj end
    end
    
    -- Busca profunda por nome do jogador
    for _, child in ipairs(Workspace:GetChildren()) do
        if child.Name:lower():find(player.Name:lower()) or child.Name == tostring(player.UserId) then
            return child
        end
    end
    
    return nil
end

-- === ENCONTRAR TODOS OS BRAINROTS NUMA BASE ===
local function findBrainrotsInBase(base)
    local brainrots = {}
    
    for _, obj in ipairs(base:GetDescendants()) do
        local name = obj.Name:lower()
        
        -- Filtros de brainrot
        if (name:find("brainrot") or name:find("brain") or 
            name:find("lucky") or name:find("block") or 
            name:find("rot") or name:find("pet") or
            name:find("rare") or name:find("secret") or
            name:find("epic") or name:find("legendary") or
            name:find("mythic") or name:find("rainbow")) then
            
            if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("MeshPart") then
                -- Ignorar partes transparentes ou invisíveis
                if obj:IsA("BasePart") and obj.Transparency > 0.8 then
                    -- Pula
                else
                    table.insert(brainrots, {
                        Object = obj,
                        Name = obj.Name,
                        Class = obj.ClassName
                    })
                end
            end
        end
    end
    
    return brainrots
end

-- === LISTAR TODAS AS BASES COM BRAINROTS ===
local function getAllBasesWithBrainrots()
    local bases = {}
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local base = findPlayerBase(player)
            if base then
                local brainrots = findBrainrotsInBase(base)
                if #brainrots > 0 then
                    table.insert(bases, {
                        Player = player,
                        Base = base,
                        Brainrots = brainrots,
                        Count = #brainrots
                    })
                end
            end
        end
    end
    
    -- Ordenar por mais brainrots primeiro
    table.sort(bases, function(a, b) return a.Count > b.Count end)
    
    return bases
end

-- === FUNÇÃO PRINCIPAL DE STEAL - BYPASS ROBUX ===
local function forceStealBrainrot(targetPlayer, brainrotObject)
    if not targetPlayer or not brainrotObject or not RemoteEvent then
        return false, "Parâmetros inválidos"
    end
    
    -- SALTO CRÍTICO: Vamos chamar o FireServer diretamente.
    -- O jogo verifica Robux no cliente ANTES de chamar isso.
    -- Nós estamos chamando ISSO DIRETAMENTE, ignorando a verificação.
    -- O servidor NÃO verifica Robux novamente (ou se verifica,
    -- vamos usar argumentos que façam ele pular essa checagem).
    
    local objectArg = brainrotObject.Object or brainrotObject
    local positionArg = nil
    
    -- Tenta obter posição
    if objectArg:IsA("BasePart") then
        positionArg = objectArg.Position
    elseif objectArg:IsA("Model") and objectArg.PrimaryPart then
        positionArg = objectArg.PrimaryPart.Position
    elseif objectArg:IsA("Model") then
        for _, part in ipairs(objectArg:GetChildren()) do
            if part:IsA("BasePart") then
                positionArg = part.Position
                break
            end
        end
    end
    
    -- LISTA DE FORMATOS DE ARGS PARA TENTAR
    -- O servidor pode esperar um formato específico que já "autoriza" o roubo
    local argFormats = {
        -- Formatos básicos com objeto
        function() return { objectArg, targetPlayer } end,
        function() return { targetPlayer, objectArg } end,
        function() return { objectArg } end,
        function() return { targetPlayer } end,
        
        -- Formatos com posição
        function() 
            if positionArg then return { positionArg, targetPlayer } end
            return nil
        end,
        function()
            if positionArg then return { targetPlayer, positionArg } end
            return nil
        end,
        function()
            if positionArg then return { positionArg, targetPlayer.UserId } end
            return nil
        end,
        
        -- Formatos com UserId
        function() return { targetPlayer.UserId, objectArg.Name } end,
        function() return { targetPlayer.UserId, objectArg } end,
        function() return { objectArg.Name, targetPlayer.UserId } end,
        function() return { targetPlayer.Name, objectArg.Name } end,
        function() return { targetPlayer.Name, targetPlayer.UserId } end,
        
        -- Formatos COM bypass de Robux (se o servidor espera um booleano/flag)
        function() return { objectArg, targetPlayer, true } end,
        function() return { objectArg, targetPlayer, 0 } end,  -- 0 = free
        function() return { objectArg, targetPlayer, "free" } end,
        function() return { objectArg, targetPlayer.UserId, true } end,
        function() return { targetPlayer, objectArg, "bypass" } end,
        function() return { targetPlayer.UserId, objectArg.Name, true } end,
        
        -- Formatos com string de comando
        function() return { "Steal", objectArg, targetPlayer } end,
        function() return { "ForceSteal", objectArg, targetPlayer } end,
        function() return { "claim", objectArg, targetPlayer } end,
        
        -- Formatos com posição e flags
        function()
            if positionArg then return { positionArg, targetPlayer.UserId, "Robux", 0 } end
            return nil
        end,
        function()
            if positionArg then return { positionArg, targetPlayer, 999999 } end
            return nil
        end,
    }
    
    for i, formatFunc in ipairs(argFormats) do
        local args = formatFunc()
        if args then
            -- Tenta 3 vezes cada formato
            for attempt = 1, 3 do
                local success, err = pcall(function()
                    RemoteEvent:FireServer(unpack(args))
                end)
                if success then
                    -- Se funcionou, retorna sucesso
                    return true, "Formato " .. i
                end
                wait(0.02)
            end
        end
    end
    
    return false, "Todos os formatos falharam"
end

-- === ROUBAR TODOS OS BRAINROTS DE UMA BASE ===
local function stealAllFromBase(baseData)
    if not baseData then return 0, 0 end
    
    local successCount = 0
    local total = #baseData.Brainrots
    
    print("[+] Iniciando roubo da base de " .. baseData.Player.Name .. " (" .. total .. " brainrots)")
    
    for i, brainrot in ipairs(baseData.Brainrots) do
        local success, format = forceStealBrainrot(baseData.Player, brainrot)
        if success then
            successCount = successCount + 1
            print("[+] [" .. i .. "/" .. total .. "] Roubado: " .. brainrot.Name .. " (formato: " .. format .. ")")
        else
            print("[-] [" .. i .. "/" .. total .. "] Falhou: " .. brainrot.Name)
        end
        wait(0.1)  -- Delay entre roubos
    end
    
    print("[+] Concluído: " .. successCount .. "/" .. total .. " brainrots roubados")
    return successCount, total
end

