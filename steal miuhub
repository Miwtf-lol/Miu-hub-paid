-- Tìm RemoteEvent rev_S_Steal
local function findRemoteEvent()
    -- Path chính xác
    local path = { "Shared", "Packages", "Network", "rev_S_Steal" }
    local obj = ReplicatedStorage
    for _, name in ipairs(path) do
        obj = obj:FindFirstChild(name)
        if not obj then break end
    end
    if obj then return obj end
    
    -- Deep search
    local function deepSearch(instance, depth)
        if depth > 6 then return nil end
        for _, child in ipairs(instance:GetChildren()) do
            if child.Name == "rev_S_Steal" and (child:IsA("RemoteEvent") or child:IsA("RemoteFunction")) then
                return child
            end
            local found = deepSearch(child, depth + 1)
            if found then return found end
        end
        return nil
    end
    
    return deepSearch(ReplicatedStorage, 0)
end

local RemoteEvent = findRemoteEvent()

if not RemoteEvent then
    -- Debug: liệt kê tất cả RemoteEvent
    local function listAll(inst, depth)
        if depth > 4 then return end
        for _, c in ipairs(inst:GetChildren()) do
            if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                warn("  " .. c:GetFullName())
            end
            listAll(c, depth + 1)
        end
    end
    warn("[!] rev_S_Steal NOT FOUND! Các RemoteEvent có sẵn:")
    listAll(ReplicatedStorage, 0)
    return
end

-- === HÀM TÌM BASE CỦA NGƯỜI CHƠI ===
-- Mỗi người chơi có base riêng (thường là folder/model trong Workspace)
local function findPlayerBase(player)
    -- Các cách game thường đặt base
    local possibleNames = {
        player.Name .. "'s Base",
        player.Name .. "sBase",
        player.Name .. "_Base",
        player.Name .. "Base",
        "Base_" .. player.Name,
        "Base" .. player.Name,
        player.Name,
        player.UserId,
        tostring(player.UserId),
        "Base_" .. player.UserId,
    }
    
    -- Tìm trong Workspace
    for _, name in ipairs(possibleNames) do
        local obj = Workspace:FindFirstChild(name)
        if obj then return obj end
    end
    
    -- Tìm trong các folder con của Workspace
    for _, child in ipairs(Workspace:GetChildren()) do
        -- Nếu là folder/model và chứa tên player
        if child.Name:lower():find(player.Name:lower()) then
            return child
        end
        -- Nếu folder chứa các phần liên quan đến base
        if child.Name:lower():find("base") or child.Name:lower():find("tycoon") or child.Name:lower():find("plot") then
            -- Kiểm tra xem folder này có thuộc về player không
            if child:FindFirstChild(player.Name) or child:FindFirstChild(tostring(player.UserId)) then
                return child
            end
        end
    end
    
    return nil
end

-- === HÀM TÌM BRAINROT TRONG BASE CỦA NGƯỜI CHƠI ===
local function findBrainrotsInBase(player)
    local base = findPlayerBase(player)
    if not base then return {} end
    
    local brainrots = {}
    
    -- Quét toàn bộ base tìm brainrot
    for _, obj in ipairs(base:GetDescendants()) do
        local name = obj.Name:lower()
        -- Kiểm tra tên brainrot
        if name:find("brainrot") or name:find("brain") or name:find("lucky.block") or name:find("luckyblock") then
            if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool") then
                table.insert(brainrots, obj)
            end
        end
        
        -- Kiểm tra các tên phổ biến khác
        if name:find("rot") or name:find("steal") or name:find("drop") then
            if obj:IsA("BasePart") and obj.Transparency < 0.5 then
                table.insert(brainrots, obj)
            end
        end
    end
    
    return brainrots
end

-- === LẤY TẤT CẢ NGƯỜI CHƠI CÓ BASE ===
local function getPlayersWithBases()
    local players = {}
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local base = findPlayerBase(player)
            if base then
                local brainrots = findBrainrotsInBase(player)
                if #brainrots > 0 then
                    table.insert(players, {
                        Player = player,
                        Base = base,
                        Brainrots = brainrots,
                        Count = #brainrots
                    })
                end
            end
        end
    end
    
    -- Sắp xếp theo số lượng brainrot giảm dần
    table.sort(players, function(a, b)
        return a.Count > b.Count
    end)
    
    return players
end

-- === HÀM STEAL BRAINROT TỪ BASE ===
local function stealBrainrotFromBase(targetPlayer, brainrotObject)
    if not targetPlayer or not RemoteEvent then
        return false, "Invalid params"
    end
    
    -- Các format args khác nhau để steal brainrot object
    local argFormats = {
        -- Format 1: {brainrotObject, targetPlayer}
        function() return { brainrotObject, targetPlayer } end,
        -- Format 2: {brainrotObject}
        function() return { brainrotObject } end,
        -- Format 3: {brainrotObject.Position, targetPlayer}
        function() 
            if brainrotObject:IsA("BasePart") then
                return { brainrotObject.Position, targetPlayer }
            end
            return nil
        end,
        -- Format 4: {brainrotObject.Position, targetPlayer.UserId}
        function()
            if brainrotObject:IsA("BasePart") then
                return { brainrotObject.Position, targetPlayer.UserId }
            end
            return nil
        end,
        -- Format 5: {targetPlayer, brainrotObject}
        function() return { targetPlayer, brainrotObject } end,
        -- Format 6: {targetPlayer.UserId, brainrotObject.Position}
        function()
            if brainrotObject:IsA("BasePart") then
                return { targetPlayer.UserId, brainrotObject.Position }
            end
            return nil
        end,
        -- Format 7: {brainrotObject.Name, targetPlayer.UserId}
        function() return { brainrotObject.Name, targetPlayer.UserId } end,
        -- Format 8: {targetPlayer.Name, brainrotObject.Name}
        function() return { targetPlayer.Name, brainrotObject.Name } end,
        -- Format 9: {brainrotObject, "Steal"}
        function() return { brainrotObject, "Steal" } end,
        -- Format 10: {targetPlayer, brainrotObject.Position, brainrotObject.Name}
        function()
            if brainrotObject:IsA("BasePart") then
                return { targetPlayer, brainrotObject.Position, brainrotObject.Name }
            end
            return nil
        end,
    }
    
    for i, formatFunc in ipairs(argFormats) do
        local args = formatFunc()
        if args then
            local success, err = pcall(function()
                RemoteEvent:FireServer(unpack(args))
                -- Gửi thêm 2 lần nữa để chắc chắn
                wait(0.05)
                RemoteEvent:FireServer(unpack(args))
                wait(0.05)
                RemoteEvent:FireServer(unpack(args))
            end)
            if success then
                return true, "Format " .. i
            end
        end
    end
    
    return false, "All formats failed"
end

-- === TÌM NGƯỜI CHƠI CÓ BASE VÀ BRAINROT GẦN NHẤT ===
local function findNearestBaseWithBrainrots()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    
    local myPos = LocalPlayer.Character.HumanoidRootPart.Position
    local bestTarget = nil
    local minDist = math.huge
    
    for _, data in ipairs(getPlayersWithBases()) do
        local base = data.Base
        local basePos = nil
        
        if base:IsA("BasePart") or (base:IsA("Model") and base.PrimaryPart) then
            basePos = (base:IsA("BasePart") and base.Position) or base.PrimaryPart.Position
        elseif #base:GetChildren() > 0 then
            -- Lấy vị trí từ phần tử đầu tiên
            for _, child in ipairs(base:GetChildren()) do
                if child:IsA("BasePart") then
                    basePos = child.Position
                    break
                end
            end
        end
        
        if basePos then
            local dist = (myPos - basePos).Magnitude
            if dist < minDist then
                minDist = dist
                bestTarget = data
            end
        end
    end
    
    return bestTarget
end

-- === STEAL ALL BRAINROTS TỪ BASE CỦA 1 NGƯỜI CHƠI ===
local function stealAllFromPlayer(data)
    if not data then return 0 end
    
    local successCount = 0
    for _, brainrot in ipairs(data.Brainrots) do
        local success, _ = stealBrainrotFromBase(data.Player, brainrot)
        if success then
            successCount = successCount + 1
        end
        wait(0.1)
    end
    
    return successCount, #data.Brainrots
end

